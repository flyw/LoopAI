{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "awaiting-user-verification", "incomplete", "blocked"]
    },
    "summary": { "type": "string", "minLength": 1 }
  },
  "required": ["status", "summary"]
}
